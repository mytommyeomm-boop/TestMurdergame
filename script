end)

-- ═══════════════ MOBILE GESTURES ═══════════════
-- ไม่มีปุ่มบนจอ — ใช้ multi-finger gesture
local Gesture = {}
do
    local fingers = {}        -- [input] = { t = tick(), gesture = bool }
    local aimActive = false
    local lastFireGesture = 0
    local lastEspGesture = 0
    local lastAimToggleGesture = 0
    local FIRE_COOLDOWN = 0.5
    local ESP_COOLDOWN = 0.5
    local AIM_TOGGLE_COOLDOWN = 0.5

    local function log(...)
        if Config.MOB_Debug then
            print("[Gesture]", ...)
        end
    end

    -- ตรวจว่าจุดนั้นอยู่นอกโซนควบคุมของเกมไหม
    -- (โซนซ้ายล่าง = joystick, โซนขวาล่าง = action buttons)
    local function inGestureZone(pos)
        local vp = Camera.ViewportSize
        local cw = vp.X * Config.MOB_ControlZoneW
        local ch = vp.Y * Config.MOB_ControlZoneH
        -- โซนซ้ายล่าง
        if pos.X < cw and pos.Y > vp.Y - ch then return false end
        -- โซนขวาล่าง
        if pos.X > vp.X - cw and pos.Y > vp.Y - ch then return false end
        return true
    end

    local function countActive()
        local n = 0
        for _ in pairs(fingers) do n = n + 1 end
        return n
    end

    local function countRecentGesture()
        local now = tick()
        local n = 0
        for _, info in pairs(fingers) do
            if info.gesture and now - info.t <= Config.MOB_GestureWindow then
                n = n + 1
            end
        end
        return n
    end

    local function countActiveGesture()
        local n = 0
        for _, info in pairs(fingers) do
            if info.gesture then n = n + 1 end
        end
        return n
    end

    if not Caps.touch then
        -- ไม่มี touch → gesture system ปิดตัวเงียบๆ
        function Gesture.Init() end
        function Gesture.Destroy() end
        return
    end

    local conns = {}

    table.insert(conns, UIS.TouchStarted:Connect(function(input)
        local pos = Vector3.new(input.Position.X, input.Position.Y, 0)
        local eligible = inGestureZone(Vector2.new(input.Position.X, input.Position.Y))
        fingers[input] = { t = tick(), gesture = eligible, pos = input.Position }

        if not Config.MOB_GestureEnabled then return end

        local recent = countRecentGesture()

        if recent == 2 and not aimActive then
            aimActive = true
            Aim.SetHeld(true)
            log("AIM START (2-finger hold)")
        elseif recent == 3 then
            if tick() - lastFireGesture >= FIRE_COOLDOWN then
                lastFireGesture = tick()
                if Config.AIM_Enabled then
                    Aim.Fire()
                    log("FIRE (3-finger tap)")
                end
            end
        elseif recent == 4 then
            if tick() - lastEspGesture >= ESP_COOLDOWN then
                lastEspGesture = tick()
                Config.ESP_Enabled = not Config.ESP_Enabled
                if not Config.ESP_Enabled then ESP:ClearAll() end
                log("ESP TOGGLE →", Config.ESP_Enabled)
                if _G._MurderSuite and _G._MurderSuite.syncUI then
                    _G._MurderSuite.syncUI("ESP_Enabled", Config.ESP_Enabled)
                end
            end
        elseif recent == 5 then
            if tick() - lastAimToggleGesture >= AIM_TOGGLE_COOLDOWN then
                lastAimToggleGesture = tick()
                Config.AIM_Enabled = not Config.AIM_Enabled
                log("AIMBOT TOGGLE →", Config.AIM_Enabled)
                if _G._MurderSuite and _G._MurderSuite.syncUI then
                    _G._MurderSuite.syncUI("AIM_Enabled", Config.AIM_Enabled)
                end
            end
        end
    end))

    table.insert(conns, UIS.TouchEnded:Connect(function(input)
        fingers[input] = nil
        if aimActive and countActiveGesture() < 2 then
            aimActive = false
            Aim.SetHeld(false)
            log("AIM END")
        end
    end))

    -- Safety: ถ้า touch หายหมด (เช่นสลับแอป) → reset
    table.insert(conns, UIS.WindowFocusReleased:Connect(function()
        fingers = {}
        if aimActive then
            aimActive = false
            Aim.SetHeld(false)
        end
    end))

    function Gesture.Destroy()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    end
end

-- ═══════════════ PC / CONSOLE INPUT ═══════════════
local inputConns = {}

local function isAimBegin(input)
    if Config.IN_UseRMB and input.UserInputType == Enum.UserInputType.MouseButton2 then return true end
    if input.KeyCode == Config.IN_KbAimKey then return true end
    if Config.IN_UseL2 and input.KeyCode == Enum.KeyCode.ButtonL2 then return true end
    return false
end

table.insert(inputConns, UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if isAimBegin(input) then Aim.SetHeld(true) end
end))
table.insert(inputConns, UIS.InputEnded:Connect(function(input, gp)
    if isAimBegin(input) then Aim.SetHeld(false) end
end))
table.insert(inputConns, UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Config.IN_EspToggleKey then
        Config.ESP_Enabled = not Config.ESP_Enabled
        if not Config.ESP_Enabled then ESP:ClearAll() end
        if _G._MurderSuite and _G._MurderSuite.syncUI then
            _G._MurderSuite.syncUI("ESP_Enabled", Config.ESP_Enabled)
        end
    end
end))
table.insert(inputConns, UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Config.IN_FireKey
    or (Config.IN_UseR2 and input.KeyCode == Enum.KeyCode.ButtonR2) then
        if Config.AIM_Enabled and not Config.AIM_AutoFire then
            Aim.Fire()
        end
    end
end))

