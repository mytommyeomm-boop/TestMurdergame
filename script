local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local UserInputService    = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local CollectionService   = game:GetService("CollectionService")
local Workspace           = game:GetService("Workspace")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local pg     = player:WaitForChild("PlayerGui")

-- ═══ 1. CONFIGURATION (แก้ตรงนี้ถ้าเล่นมือถือ) ══════════════════
local CFG = {
    skillcheck = { enabled = true, margin = 2.5, cooldown = 0.1 },
    
    espKiller  = { enabled = true, maxDist = 500, colorNear = Color3.fromRGB(255, 40, 40), colorFar = Color3.fromRGB(255, 150, 150) },
    espSurv    = { enabled = true, maxDist = 500, colorNear = Color3.fromRGB(60, 255, 120), colorFar = Color3.fromRGB(60, 180, 255) },
    
    aimbot = {
        enabled       = false,     -- เปิด/ปิด Aimbot (แนะนำ true สำหรับมือถือ)
        mode          = "trigger", -- "trigger" = ยิงทันทีเมื่อเล็งโดน (ไม่ต้องกดค้าง)
        fov           = 90,
        maxDist       = 500,
        aimPart       = "Head",
        autoFire      = true,
        fireCooldown  = 0.08,
        aimThreshold  = 0.999,
        visibleOnly   = true,
        holding       = false,
    },
}

-- ═══ 2. UTILITIES ══════════════════════════════════════════════
local function isKiller(m)
    if not (m and m:IsA("Model")) then return false end
    local h = m:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    local p = Players:GetPlayerFromCharacter(m)
    if p and p.Team and p.Team.Name == "Killer" then return true end
    return CollectionService:HasTag(m, "Killer")
end

local function isSurvivor(m)
    if not (m and m:IsA("Model")) then return false end
    local h = m:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    local p = Players:GetPlayerFromCharacter(m)
    if p and p.Team and p.Team.Name == "Survivors" then return true end
    return CollectionService:HasTag(m, "Survivors")
end

local function getRoot(m)
    return m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("Torso")
end

local function lerpColor(c1, c2, t)
    return Color3.new(
        c1.R + (c2.R - c1.R) * t,
        c1.G + (c2.G - c1.G) * t,
        c1.B + (c2.B - c1.B) * t
    )
end

-- ═══ 3. SKILL CHECK (Ray UI Angular) ═══════════════════════════
local skillGui   = pg:WaitForChild("SkillCheckPromptGui")
local skillCheck = skillGui:WaitForChild("Check")
local line       = skillCheck:WaitForChild("Line")
local goal       = skillCheck:WaitForChild("Goal")
local lastGoalRot, lastFired = nil, 0

local function angleToRay(deg)
    local r = math.rad(deg)
    return Vector2.new(math.cos(r), math.sin(r))
end

local function isInSuccessZone()
    local la = line.Rotation % 360
    if la < 0 then la = la + 360 end
    local off = goal.Rotation
    local sStart = (102 + off) % 360
    local sEnd   = (116 + off) % 360
    local vL, vS = angleToRay(la), angleToRay(sStart)
    local sweep = (sEnd - sStart) % 360
    if sweep > 180 then sweep = sweep - 360 end
    local d = math.deg(math.atan2(vS.X*vL.Y - vS.Y*vL.X, vS:Dot(vL)))
    
    if sweep >= 0 then
        return d >= -CFG.skillcheck.margin and d <= sweep + CFG.skillcheck.margin
    else
        return d >= sweep - CFG.skillcheck.margin or d <= CFG.skillcheck.margin
    end
end

local function triggerSkillCheck()
    local now = os.clock()
    if now - lastFired < CFG.skillcheck.cooldown then return end
    lastFired = now
    
    -- 🔥 ใช้ Space แทน MouseClick เพื่อไม่ให้เดินค้าง
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end)
end

RunService.RenderStepped:Connect(function()
    if not CFG.skillcheck.enabled then return end
    if not skillCheck.Visible or not line.Visible then return end
    if isInSuccessZone() and lastGoalRot ~= goal.Rotation then
        lastGoalRot = goal.Rotation
        triggerSkillCheck()
    end
end)

-- ═══ 4. ESP SYSTEM (Killer & Survivor) ═════════════════════════
local kTracked, sTracked = {}, {}

local function createESP(m, isK)
    local e = {}
    local cNear = isK and CFG.espKiller.colorNear or CFG.espSurv.colorNear
    local hl = Instance.new("Highlight")
    hl.Name = isK and "ESP_Killer" or "ESP_Survivor"
    hl.Adornee = m
    hl.FillColor = cNear
    hl.OutlineColor = cNear
    hl.FillTransparency = 0.55
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = m
    e.hl = hl
    
    local root = getRoot(m)
    if root then
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 160, 0, isK and 36 or 50)
        bb.Adornee = root
        bb.StudsOffset = Vector3.new(0, 3.2, 0)
        bb.AlwaysOnTop = true
        bb.MaxDistance = isK and CFG.espKiller.maxDist or CFG.espSurv.maxDist
        bb.Parent = root
        
        local n = Instance.new("TextLabel")
        n.Name = "N"
        n.Size = UDim2.new(1, 0, 0, 18)
        n.BackgroundTransparency = 1
        n.Text = "?"
        n.TextColor3 = Color3.new(1,1,1)
        n.TextStrokeTransparency = 0
        n.Font = Enum.Font.GothamBold
        n.TextScaled = true
        n.Parent = bb
        
        local i = Instance.new("TextLabel")
        i.Name = "I"
        i.Size = UDim2.new(1, 0, 0, 14)
        i.Position = UDim2.new(0, 0, 0, 18)
        i.BackgroundTransparency = 1
        i.Text = ""
        i.TextColor3 = isK and Color3.fromRGB(255,220,120) or Color3.fromRGB(200,255,200)
        i.TextStrokeTransparency = 0
        i.Font = Enum.Font.Gotham
        i.TextScaled = true
        i.Parent = bb
        
        if not isK then
            local s = Instance.new("TextLabel")
            s.Name = "S"
            s.Size = UDim2.new(1, 0, 0, 14)
            s.Position = UDim2.new(0, 0, 0, 32)
            s.BackgroundTransparency = 1
            s.Text = ""
            s.TextColor3 = Color3.fromRGB(255, 200, 60)
            s.TextStrokeTransparency = 0
            s.Font = Enum.Font.GothamBold
            s.TextScaled = true
            s.Parent = bb
        end
        e.bb = bb
    end
    return e
end

local function removeESP(m, isK)
    local tab = isK and kTracked or sTracked
    local e = tab[m]
    if not e then return end
    if e.hl then e.hl:Destroy() end
    if e.bb then e.bb:Destroy() end
    tab[m] = nil
end

task.spawn(function()
    while true do
        local myChar = player.Character
        local myP = Players:GetPlayerFromCharacter(myChar)
        local iAmKiller = myP and myP.Team and myP.Team.Name == "Killer"
        
        if CFG.espKiller.enabled then
            local seen = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character and isKiller(p.Character) then
                    seen[p.Character] = true
                    if not kTracked[p.Character] then kTracked[p.Character] = createESP(p.Character, true) end
                end
            end
            for m in pairs(kTracked) do
                if not seen[m] or not m:IsDescendantOf(Workspace) or not isKiller(m) then removeESP(m, true) end
            end
        end
        
        if CFG.espSurv.enabled and iAmKiller then
            local seen = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character and isSurvivor(p.Character) then
                    seen[p.Character] = true
                    if not sTracked[p.Character] then sTracked[p.Character] = createESP(p.Character, false) end
                end
            end
            for m in pairs(sTracked) do
                if not seen[m] or not m:IsDescendantOf(Workspace) or not isSurvivor(m) then removeESP(m, false) end
            end
        elseif not iAmKiller then
            for m in pairs(sTracked) do removeESP(m, false) end
        end
        task.wait(0.5)
    end
end)

RunService.RenderStepped:Connect(function()
    local myChar = player.Character
    if not myChar then return end
    local myRoot = getRoot(myChar)
    if not myRoot then return end
    
    for m, e in pairs(kTracked) do
        if CFG.espKiller.enabled and e.bb then
            local root = getRoot(m)
            if root then
                local h = m:FindFirstChildOfClass("Humanoid")
                local d = (root.Position - myRoot.Position).Magnitude
                local t = math.clamp(d / CFG.espKiller.maxDist, 0, 1)
                local col = lerpColor(CFG.espKiller.colorNear, CFG.espKiller.colorFar, t)
                e.hl.FillColor, e.hl.OutlineColor = col, col
                
                local n, i = e.bb:FindFirstChild("N"), e.bb:FindFirstChild("I")
                if n then n.Text = m.Name; n.TextColor3 = col end
                if i and h then i.Text = string.format("%dm • %dHP", math.floor(d), math.floor(h.Health)) end
            end
        end
    end
    
    for m, e in pairs(sTracked) do
        if CFG.espSurv.enabled and e.bb then
            local root = getRoot(m)
            if root then
                local h = m:FindFirstChildOfClass("Humanoid")
                local d = (root.Position - myRoot.Position).Magnitude
                local t = math.clamp(d / CFG.espSurv.maxDist, 0, 1)
                local col = lerpColor(CFG.espSurv.colorNear, CFG.espSurv.colorFar, t)
                e.hl.FillColor, e.hl.OutlineColor = col, col
                
                local n, i, s = e.bb:FindFirstChild("N"), e.bb:FindFirstChild("I"), e.bb:FindFirstChild("S")
                if n then n.Text = m.Name; n.TextColor3 = col end
                if i and h then i.Text = string.format("%dm • %dHP", math.floor(d), math.floor(h.Health)) end
                if s then
                    if m:GetAttribute("IsCarried") then s.Text = "🫳 CARRIED"; s.TextColor3 = Color3.fromRGB(255,80,80)
                    elseif m:GetAttribute("IsHooked") then s.Text = "🪝 HOOKED"; s.TextColor3 = Color3.fromRGB(255,100,200)
                    elseif h and h.Health <= 0 then s.Text = "💀 DEAD"; s.TextColor3 = Color3.fromRGB(150,150,150)
                    elseif h and h.Health < h.MaxHealth * 0.5 then s.Text = "🩸 INJURED"; s.TextColor3 = Color3.fromRGB(255,150,60)
                    else s.Text = "🏃 RUNNING"; s.TextColor3 = Color3.fromRGB(150,255,150)
                    end
                end
            end
        end
    end
end)

-- ═══ 5. AIMBOT ═════════════════════════════════════════════════
local lastAimFire = 0

local function getAimPos(m)
    if CFG.aimbot.aimPart == "Head" then
        local h = m:FindFirstChild("Head"); return h and h.Position
    elseif CFG.aimbot.aimPart == "Torso" then
        local t = m:FindFirstChild("UpperTorso") or m:FindFirstChild("Torso"); return t and t.Position
    else
        local h = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart"); return h and h.Position
    end
end

local function isVisible(target, pos)
    local cp = camera.CFrame.Position
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { player.Character, camera }
    local hit = Workspace:Raycast(cp, pos - cp, rp)
    return (not hit) or hit.Instance:IsDescendantOf(target)
end

local function findBestTarget()
    local cp, cl = camera.CFrame.Position, camera.CFrame.LookVector
    local maxA = math.rad(CFG.aimbot.fov / 2)
    local best, bestPos, bestD = nil, nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        local c = p.Character
        if not isKiller(c) then continue end
        local ap = getAimPos(c)
        if not ap then continue end
        local d = ap - cp
        local dist = d.Magnitude
        if dist > CFG.aimbot.maxDist then continue end
        local ang = math.acos(math.clamp(cl:Dot(d.Unit), -1, 1))
        if ang > maxA then continue end
        if CFG.aimbot.visibleOnly and not isVisible(c, ap) then continue end
        if dist < bestD then best, bestPos, bestD = c, ap, dist end
    end
    return best, bestPos
end

local function fireGun()
    local char = player.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    -- 🔥 ใช้ tool:Activate() แทนการคลิกหน้าจอ เพื่อไม่ให้เดินค้าง
    if tool then
        pcall(function() tool:Activate() end)
    end
end

RunService.RenderStepped:Connect(function(dt)
    if not CFG.aimbot.enabled then return end

    if CFG.aimbot.mode == "trigger" then
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = { player.Character, camera }
        local hit = Workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * CFG.aimbot.maxDist, rp)
        if hit then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character and isKiller(p.Character) and hit.Instance:IsDescendantOf(p.Character) then
                    if CFG.aimbot.autoFire then
                        local now = os.clock()
                        if now - lastAimFire > CFG.aimbot.fireCooldown then lastAimFire = now; fireGun() end
                    end
                    break
                end
            end
        end
        return
    end

    local holding = CFG.aimbot.holding or UserInputService:IsKeyDown(Enum.KeyCode.C)
    if not holding then return end

    local t, pos = findBestTarget()
    if not t then return end
    local cp = camera.CFrame.Position
    local desired = CFrame.new(cp, pos)
    
    if CFG.aimbot.mode == "rage" then
        camera.CFrame = desired
    else
        camera.CFrame = camera.CFrame:Lerp(desired, math.clamp(dt * 20, 0, 1))
    end
    
    if CFG.aimbot.autoFire then
        local look = camera.CFrame.LookVector
        local dir = (pos - cp).Unit
        if look:Dot(dir) > CFG.aimbot.aimThreshold then
            local now = os.clock()
            if now - lastAimFire > CFG.aimbot.fireCooldown then lastAimFire = now; fireGun() end
        end
    end
end)

-- ═══ 6. PC KEYBOARD SHORTCUTS ══════════════════════════════════
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        CFG.aimbot.enabled = not CFG.aimbot.enabled
        print("[Aim] " .. (CFG.aimbot.enabled and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.RightControl then
        CFG.espKiller.enabled = not CFG.espKiller.enabled
        if not CFG.espKiller.enabled then for m in pairs(kTracked) do removeESP(m, true) end end
        print("[ESP Killer] " .. (CFG.espKiller.enabled and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.RightAlt then
        CFG.espSurv.enabled = not CFG.espSurv.enabled
        if not CFG.espSurv.enabled then for m in pairs(sTracked) do removeESP(m, false) end end
        print("[ESP Surv] " .. (CFG.espSurv.enabled and "ON" or "OFF"))
    end
end)

