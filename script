-- ============================================================
--  MURDER GAME HELPER – v2 (fixed)
--  Auto Repair + Killer ESP + Killer-Only Aim Assist
-- ============================================================

-- [[ SERVICES ]]
local Players            = game:GetService("Players")
local RunService         = game:GetService("RunService")
local CollectionService  = game:GetService("CollectionService")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local VirtualInputManager= game:GetService("VirtualInputManager")

local LP     = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- [[ CONFIG ]]
local TEAM_KILLER       = "Killer"
local TAG_KILLER        = "Killer"
local GUN_NAME_PATTERNS = {
    "gun","pistol","rifle","shotgun","smg","sniper",
    "revolver","glock","beretta","magnum","ak","m4","colt"
}

local State = {
    AimSmoothness   = 0.15,
    AimFOV          = 90,
    AimRequireGun   = true,
}

-- ============================================================
--  HELPERS
-- ============================================================
local function isKillerPlayer(player)
    if not player then return false end
    if player.Team and player.Team.Name == TEAM_KILLER then return true end
    local char = player.Character
    if char and CollectionService:HasTag(char, TAG_KILLER) then return true end
    if CollectionService:HasTag(player, TAG_KILLER) then return true end
    return false
end

local function findGunTool()
    local char = LP.Character
    if not char then return nil end
    -- Prefer tools that look like guns
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local n = tool.Name:lower()
            for _, pat in ipairs(GUN_NAME_PATTERNS) do
                if n:find(pat) then return tool end
            end
        end
    end
    -- If user disabled the "require gun" option, any tool counts
    if not State.AimRequireGun then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then return tool end
        end
    end
    return nil
end

local function getTargetPart(character)
    return character:FindFirstChild("Head")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("HumanoidRootPart")
end

local function notify(title, text)
    if Rayfield then
        pcall(function()
            Rayfield:Notify({Title = title, Content = text, Duration = 2})
        end)
    end
    print(("[MG] %s – %s"):format(title, text))
end

-- ============================================================
--  AUTO REPAIR
--  Success window in game code:  102 <= (Line.Rotation - Goal.Rotation) <= 116
-- ============================================================
local AutoRepair = {
    Active   = false,
    Fired    = false,
    SkillGui = nil,
    Line     = nil,
    Goal     = nil,
    Conns    = {},
}

local function addARConn(c) table.insert(AutoRepair.Conns, c) return c end

local function disconnectAR()
    for _, c in ipairs(AutoRepair.Conns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(AutoRepair.Conns)
end

local function ensureSkillGui()
    if AutoRepair.SkillGui and AutoRepair.SkillGui.Parent
       and AutoRepair.Line and AutoRepair.Line.Parent
       and AutoRepair.Goal and AutoRepair.Goal.Parent then
        return true
    end
    local pGui = LP:FindFirstChild("PlayerGui")
    if not pGui then return false end
    local scg = pGui:FindFirstChild("SkillCheckPromptGui")
    if not scg then return false end
    local check = scg:FindFirstChild("Check")
    if not check then return false end
    AutoRepair.SkillGui = check
    AutoRepair.Line     = check:FindFirstChild("Line")
    AutoRepair.Goal     = check:FindFirstChild("Goal")
    return AutoRepair.Line ~= nil and AutoRepair.Goal ~= nil
end

local function hookSkillCheckEvents()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then return end

    local generator = remotes:FindFirstChild("Generator")
    if generator then
        local ev = generator:FindFirstChild("SkillCheckEvent")
        if ev then
            addARConn(ev.OnClientEvent:Connect(function()
                AutoRepair.Fired = false
            end))
        end
    end

    local healing = remotes:FindFirstChild("Healing")
    if healing then
        local ev = healing:FindFirstChild("SkillCheckEvent")
        if ev then
            addARConn(ev.OnClientEvent:Connect(function()
                AutoRepair.Fired = false
            end))
        end
    end
end

local function pressSpace()
    -- VirtualInputManager triggers the game's InputBegan handler for Space
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
    end)
    task.wait(0.03)
    pcall(function()
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end)
end

local function startAutoRepair()
    if AutoRepair.Active then return end
    AutoRepair.Active = true
    AutoRepair.Fired = false

    hookSkillCheckEvents()

    -- Poll every frame for maximum precision (only a few comparisons)
    addARConn(RunService.RenderStepped:Connect(function()
        if not AutoRepair.Active then return end
        if not ensureSkillGui() then return end
        if not AutoRepair.SkillGui.Visible then return end
        if AutoRepair.Fired then return end

        local diff = AutoRepair.Line.Rotation - AutoRepair.Goal.Rotation
        if diff >= 102 and diff <= 116 then
            AutoRepair.Fired = true
            pressSpace()
            notify("Auto Repair", ("Fired (diff = %.1f)"):format(diff))
        end
    end))

    notify("Auto Repair", "Enabled")
end

local function stopAutoRepair()
    AutoRepair.Active = false
    AutoRepair.Fired = false
    disconnectAR()
    notify("Auto Repair", "Disabled")
end

-- ============================================================
--  KILLER ESP
-- ============================================================
local KillESP = {
    Active     = false,
    Highlights = {},
    Conns      = {},
}

local function addESPConn(c) table.insert(KillESP.Conns, c) return c end

local function removeESP(player)
    local hl = KillESP.Highlights[player]
    if hl then
        pcall(function() hl:Destroy() end)
        KillESP.Highlights[player] = nil
    end
end

local function applyESP(player)
    if not KillESP.Active then return end
    if not isKillerPlayer(player) then return end
    local char = player.Character
    if not char then return end

    removeESP(player)

    local hl = Instance.new("Highlight")
    hl.Name               = "MG_KillerESP"
    hl.Adornee            = char
    hl.FillColor          = Color3.fromRGB(255, 0, 0)
    hl.OutlineColor       = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency   = 0.4
    hl.OutlineTransparency= 0
    hl.DepthMode          = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent             = char

    KillESP.Highlights[player] = hl
end

local function refreshESP()
    for player in pairs(KillESP.Highlights) do
        if not player.Parent or not isKillerPlayer(player) then
            removeESP(player)
        end
    end
    if KillESP.Active then
        for _, p in ipairs(Players:GetPlayers()) do
            if isKillerPlayer(p) and p.Character then
                if not KillESP.Highlights[p] then
                    applyESP(p)
                end
            end
        end
    end
end

local function startESP()
    if KillESP.Active then return end
    KillESP.Active = true

    for _, p in ipairs(Players:GetPlayers()) do
        applyESP(p)
        addESPConn(p.CharacterAdded:Connect(function()
            task.wait(0.5)
            applyESP(p)
        end))
    end

    addESPConn(Players.PlayerAdded:Connect(function(p)
        addESPConn(p.CharacterAdded:Connect(function()
            task.wait(0.5)
            applyESP(p)
        end))
    end))

    addESPConn(Players.PlayerRemoving:Connect(removeESP))

    -- Refresh loop for team changes (very cheap)
    task.spawn(function()
        while KillESP.Active do
            task.wait(1.5)
            if KillESP.Active then refreshESP() end
        end
    end)

    notify("Killer ESP", "Enabled")
end

local function stopESP()
    KillESP.Active = false
    for _, c in ipairs(KillESP.Conns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(KillESP.Conns)
    for p in pairs(KillESP.Highlights) do
        removeESP(p)
    end
    notify("Killer ESP", "Disabled")
end

-- ============================================================
--  AIM ASSIST (Killer only)
--  Uses BindToRenderStep AFTER camera update so our CFrame
--  setter wins against the game's own camera module.
-- ============================================================
local Aim = {
    Active = false,
    Target = nil,
}

local function findAimTarget()
    local camPos  = Camera.CFrame.Position
    local camLook = Camera.CFrame.LookVector
    local best    = nil
    local bestDist= math.huge
    local cosFov  = math.cos(math.rad(State.AimFOV))

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        if not isKillerPlayer(player) then continue end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = getTargetPart(char)
        if not part then continue end

        local delta = part.Position - camPos
        local dist  = delta.Magnitude
        if dist < 0.01 then continue end
        local dir = delta / dist
        if camLook:Dot(dir) < cosFov then continue end

        if dist < bestDist then
            bestDist = dist
            best     = part
        end
    end
    return best
end

local function aimRenderStep()
    if not Aim.Active then return end

    if State.AimRequireGun and not findGunTool() then
        Aim.Target = nil
        return
    end

    local target = findAimTarget()
    if not target then
        Aim.Target = nil
        return
    end
    Aim.Target = target

    local camPos    = Camera.CFrame.Position
    local targetPos = target.Position
    local goal      = CFrame.lookAt(camPos, targetPos)
    Camera.CFrame   = Camera.CFrame:Lerp(goal, State.AimSmoothness)
end

local AIM_BIND = "MG_AimAssist"
local aimBound = false

local function startAim()
    if Aim.Active then return end
    Aim.Active = true
    if not aimBound then
        aimBound = true
        pcall(function() RunService:UnbindFromRenderStep(AIM_BIND) end)
        RunService:BindToRenderStep(
            AIM_BIND,
            Enum.RenderPriority.Camera.Value + 1,   -- runs AFTER camera module
            aimRenderStep
        )
    end
    notify("Aim Assist", "Enabled")
end

local function stopAim()
    Aim.Active = false
    Aim.Target = nil
    if aimBound then
        aimBound = false
        pcall(function() RunService:UnbindFromRenderStep(AIM_BIND) end)
    end
    notify("Aim Assist", "Disabled")
end

