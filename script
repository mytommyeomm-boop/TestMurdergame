-- ═══════════════ ESP CORE ═══════════════
local ESP = {}
do
    local entities, indic, seen = {}, {}, {}
    local lastTick = 0

    local gui = Instance.new("ScreenGui")
    gui.Name = "MurderESP"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 999
    gui.Parent = PlayerGui
    ESP.Gui = gui

    local FONT = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)

    local function getRoot(m)
        return m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")
            or m:FindFirstChild("UpperTorso") or m:FindFirstChild("Torso")
            or m:FindFirstChild("Head") or m:FindFirstChildWhichIsA("BasePart")
    end

    local function createESP(model, color)
        local e = entities[model]
        if e then
            e.hl.FillColor = color; e.hl.OutlineColor = color
            if e.nameLbl then e.nameLbl.TextColor3 = color end
            return e
        end
        local hl = Instance.new("Highlight")
        hl.Adornee = model
        hl.FillColor = color; hl.FillTransparency = 0.55
        hl.OutlineColor = color; hl.OutlineTransparency = 0.1
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = gui

        local root = getRoot(model)
        local bb, nameLbl, distLbl
        if root then
            bb = Instance.new("BillboardGui")
            bb.Adornee = root
            bb.Size = UDim2.new(0, 220, 0, 40)
            bb.StudsOffset = Vector3.new(0, 3, 0)
            bb.AlwaysOnTop = true
            bb.MaxDistance = Config.ESP_MaxDist
            bb.LightInfluence = 0
            bb.Parent = gui

            nameLbl = Instance.new("TextLabel")
            nameLbl.BackgroundTransparency = 1
            nameLbl.Size = UDim2.new(1, 0, 0.5, 0)
            nameLbl.FontFace = FONT
            nameLbl.TextSize = Config.ESP_TextSize
            nameLbl.TextColor3 = color
            nameLbl.TextStrokeTransparency = 0.5
            nameLbl.Parent = bb

            distLbl = Instance.new("TextLabel")
            distLbl.BackgroundTransparency = 1
            distLbl.Position = UDim2.new(0, 0, 0.5, 0)
            distLbl.Size = UDim2.new(1, 0, 0.5, 0)
            distLbl.FontFace = FONT
            distLbl.TextSize = Config.ESP_TextSize - 2
            distLbl.TextColor3 = Color3.fromRGB(230, 230, 230)
            distLbl.TextStrokeTransparency = 0.5
            distLbl.Parent = bb
        end
        e = { hl = hl, bb = bb, nameLbl = nameLbl, distLbl = distLbl }
        entities[model] = e
        return e
    end

    local function destroyESP(m)
        local e = entities[m]; if not e then return end
        if e.hl then e.hl:Destroy() end
        if e.bb then e.bb:Destroy() end
        entities[m] = nil
    end

    local function createIndicator(model, color)
        local i = indic[model]
        if i then i.frame.BackgroundColor3 = color; return i end
        local f = Instance.new("Frame")
        f.Size = UDim2.new(0, 26, 0, 26)
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.BackgroundColor3 = color
        f.BackgroundTransparency = 0.35
        f.BorderSizePixel = 0
        f.Visible = false
        f.ZIndex = 100
        f.Parent = gui
        Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
        local s = Instance.new("UIStroke", f)
        s.Color = Color3.new(1, 1, 1); s.Thickness = 2
        local a = Instance.new("TextLabel", f)
        a.BackgroundTransparency = 1
        a.Size = UDim2.new(1, 0, 1, 0)
        a.Text = "▲"; a.TextColor3 = Color3.new(1, 1, 1); a.TextSize = 18
        a.Font = Enum.Font.GothamBold
        i = { frame = f, arrow = a }
        indic[model] = i
        return i
    end

    local function destroyIndicator(m)
        local i = indic[m]; if not i then return end
        if i.frame then i.frame:Destroy() end
        indic[m] = nil
    end

    local function updateOffscreen(model, root, color)
        if not Config.ESP_Offscreen then return end
        local i = createIndicator(model, color)
        local ss = Camera.ViewportSize
        local sp, onScreen = Camera:WorldToViewportPoint(root.Position)
        if onScreen and sp.Z > 0 and sp.X > 0 and sp.X < ss.X and sp.Y > 0 and sp.Y < ss.Y then
            i.frame.Visible = false; return
        end
        local c = ss / 2
        local dx, dy
        if sp.Z < 0 then
            dx = c.X - sp.X; dy = c.Y - sp.Y
            if math.abs(dx) < 0.1 and math.abs(dy) < 0.1 then dy = 1 end
        else
            dx = sp.X - c.X; dy = sp.Y - c.Y
        end
        local pad = Config.ESP_PadSize
        local mx = ss.X / 2 - pad; local my = ss.Y / 2 - pad
        local sx = dx ~= 0 and (mx / math.abs(dx)) or math.huge
        local sy = dy ~= 0 and (my / math.abs(dy)) or math.huge
        local sc = math.min(sx, sy, 1)
        i.frame.Position = UDim2.fromOffset(c.X + dx * sc, c.Y + dy * sc)
        i.frame.Visible = true
        i.arrow.Rotation = math.deg(math.atan2(dy, dx)) + 90
    end

    local function classifySurvivor(plr)
        local c = plr.Character; if not c then return nil end
        if c:GetAttribute("IsCarried") then return "carried" end
        if c:GetAttribute("IsHooked") then return "hooked" end
        if CollectionService:HasTag(c, "Knocked") then return "knocked" end
        if CollectionService:HasTag(c, "Hooked") then return "hooked" end
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then
            if h.Health <= 0 then return "dead" end
            if h.Health < h.MaxHealth * 0.5 then return "injured" end
        end
        return "healthy"
    end

    local function statusColor(plr)
        local s = classifySurvivor(plr)
        if s == "hooked" then return Config.ESP_HookedColor, " [HOOKED]" end
        if s == "knocked" then return Config.ESP_KnockedColor, " [DOWN]" end
        if s == "carried" then return Config.ESP_CarriedColor, " [CARRIED]" end
        if s == "injured" then return Config.ESP_InjuredColor, " [INJ]" end
        return Config.ESP_SurvivorColor, ""
    end

    local function processCharacter(plr, color, tag)
        local char = plr.Character
        local root = getRoot(char); if not root then return end
        local e = createESP(char, color)
        if e.bb then e.bb.MaxDistance = Config.ESP_MaxDist end
        if e.nameLbl then
            e.nameLbl.Text = (Config.ESP_ShowName and plr.Name or "") .. (tag or "")
            e.nameLbl.TextColor3 = color
            e.nameLbl.TextSize = Config.ESP_TextSize
        end
        local dist = (root.Position - Camera.CFrame.Position).Magnitude
        if e.distLbl then
            local txt = Config.ESP_ShowDistance and string.format("%dm", math.floor(dist)) or ""
            if plr.Team and plr.Team.Name == "Killer" and Config.ESP_ShowTR then
                local tr = char:GetAttribute("TerrorRadius") or plr:GetAttribute("TerrorRadius") or 0
                if tr > 0 then txt = txt .. string.format(" • TR %dm", math.floor(tr)) end
            end
            e.distLbl.Text = txt
            e.distLbl.TextSize = Config.ESP_TextSize - 2
        end
        e.hl.FillColor = color; e.hl.OutlineColor = color
        seen[char] = true
        if dist < Config.ESP_MaxDist * 2 then updateOffscreen(char, root, color) end
    end

    local function processGenerator(gen)
        local root = getRoot(gen); if not root then return end
        local prog = gen:GetAttribute("RepairProgress") or 0
        local done = prog >= 100
        local color = done and Config.ESP_GenDoneColor or Config.ESP_GenColor
        local e = createESP(gen, color)
        if e.bb then e.bb.MaxDistance = Config.ESP_MaxDist end
        if e.nameLbl then
            e.nameLbl.Text = "Generator"
            e.nameLbl.TextColor3 = color
            e.nameLbl.TextSize = Config.ESP_TextSize
        end
        local dist = (root.Position - Camera.CFrame.Position).Magnitude
        if e.distLbl then
            local s = done and "✓ DONE" or string.format("%d%%", math.floor(prog))
            e.distLbl.Text = string.format("%s • %dm", s, math.floor(dist))
            e.distLbl.TextSize = Config.ESP_TextSize - 2
        end
        e.hl.FillColor = color; e.hl.OutlineColor = color
        seen[gen] = true
        if dist < Config.ESP_MaxDist * 2 then updateOffscreen(gen, root, color) end
    end

    function ESP:ClearAll()
        for m in pairs(entities) do destroyESP(m) end
        for m in pairs(indic) do destroyIndicator(m) end
    end

    function ESP:Tick()
        if not Config.ESP_Enabled then return end
        local now = os.clock()
        if now - lastTick < Config.ESP_Interval then return end
        lastTick = now

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LP or not plr.Character then continue end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local tn = plr.Team and plr.Team.Name or ""
            if tn == "Killer" and Config.ESP_ShowKiller then
                processCharacter(plr, Config.ESP_KillerColor, " [KILLER]")
            elseif tn == "Survivors" and Config.ESP_ShowSurvivor then
                local c, t = statusColor(plr)
                processCharacter(plr, c, t)
            end
        end

        if Config.ESP_ShowGenerator then
            for _, gen in ipairs(CollectionService:GetTagged("Generator")) do
                if gen:IsA("Model") and gen:IsDescendantOf(Workspace) then
                    processGenerator(gen)
                end
            end
        end

        for m in pairs(entities) do if not seen[m] then destroyESP(m) end end
        for m in pairs(indic) do if not seen[m] then destroyIndicator(m) end end
        table.clear(seen)
    end

    function ESP:Destroy()
        self:ClearAll(); if gui then gui:Destroy() end
    end
end

local espConn = RunService.Heartbeat:Connect(function() ESP:Tick() end)

-- ═══════════════ AUTO REPAIR CORE ═══════════════
local AR = {}
do
    local RG = RS:WaitForChild("Remotes"):WaitForChild("Generator")
    local SkillEvent  = RG:WaitForChild("SkillCheckEvent")
    local ResultEvent = RG:WaitForChild("SkillCheckResultEvent")
    local Sc = RS.Remotes.KillerPerks.kingscourge
    local ScourgeStart = Sc:WaitForChild("KingScourgeStart")
    local ScourgeHit   = Sc:WaitForChild("KingScourgeHit")
    local ScourgeEnd   = Sc:WaitForChild("KingScourgeEnd")

    local sg = PlayerGui:WaitForChild("SkillCheckPromptGui"):WaitForChild("Check")
    local line = sg:WaitForChild("Line")
    local goal = sg:WaitForChild("Goal")

    local active, blockedFail = false, false
    local genId, pointId = nil, nil
    local isScourge, remaining = false, 0

    local hooked = false
    if hookfunction and newcclosure then
        local old = ResultEvent.FireServer
        hookfunction(old, newcclosure(function(self, action, ...)
            if blockedFail and action == "fail" then return end
            return old(self, action, ...)
        end))
        hooked = true
    elseif getrawmetatable and setreadonly and newcclosure then
        local mt = getrawmetatable(game)
        local oldNC = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod() == "FireServer" and self == ResultEvent and blockedFail then
                local a = {...}; if a[1] == "fail" then return end
            end
            return oldNC(self, ...)
        end)
        setreadonly(mt, true); hooked = true
    end
    if Config.AR_Debug then print("[AR] Fail-hook:", hooked) end

    local function norm(d) return d % 360 end
    local function inSuccess()
        local l = norm(line.Rotation)
        local lo = norm(102 + goal.Rotation)
        local hi = norm(116 + goal.Rotation)
        if lo <= hi then return l >= lo and l <= hi end
        return l >= lo or l <= hi
    end
    local function nearCenter()
        local l = norm(line.Rotation)
        local c = norm(109 + goal.Rotation)
        return math.abs(((l - c + 180) % 360) - 180) <= Config.AR_CenterTol
    end
    local function shouldFire()
        return Config.AR_PreferCenter and nearCenter() or inSuccess()
    end

    local function runSkillcheck(g, p)
        genId, pointId = g, p
        active, blockedFail = true, true
        task.wait(0.55)
        if not active then return end
        local t0 = os.clock()
        while active and (os.clock() - t0 < Config.AR_SafetyTimeout) do
            if shouldFire() then
                ResultEvent:FireServer("success", 1, genId, pointId)
                active = false; return
            end
            RunService.Heartbeat:Wait()
        end
        active = false
    end

    SkillEvent.OnClientEvent:Connect(function(g, p)
        if not Config.AR_Enabled then return end
        task.spawn(runSkillcheck, g, p)
    end)

    ScourgeStart.OnClientEvent:Connect(function(g, p, hits)
        if not Config.AR_Enabled then return end
        genId, pointId = g, p
        remaining = hits or 1
        isScourge, active, blockedFail = true, true, true
        task.spawn(function()
            task.wait(0.55)
            local lastG = goal.Rotation; local t0 = os.clock()
            while isScourge and remaining > 0 and (os.clock() - t0 < Config.AR_SafetyTimeout * (remaining + 1)) do
                if shouldFire() then
                    ScourgeHit:FireServer(pointId, "success")
                    remaining = remaining - 1
                    if remaining <= 0 then break end
                    local tw = os.clock()
                    while goal.Rotation == lastG and (os.clock() - tw) < 2 do RunService.Heartbeat:Wait() end
                    lastG = goal.Rotation; task.wait(0.1)
                end
                RunService.Heartbeat:Wait()
            end
            active, isScourge = false, false
        end)
    end)

    ScourgeEnd.OnClientEvent:Connect(function(id)
        if id == pointId then active, isScourge, remaining = false, false, 0 end
    end)

    function AR.Cancel() active, blockedFail, isScourge, remaining = false, false, false, 0 end
    function AR.Destroy() AR.Cancel() end

    task.spawn(function()
        while true do task.wait(1); if not active then blockedFail = false end end
    end)
end

-- ═══════════════ AIMBOT CORE ═══════════════
local Aim = {}
do
    local aimHeld      = false
    local lastFire     = 0
    local currentTarget = nil

    local gui = Instance.new("ScreenGui")
    gui.Name = "MurderAim"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 998
    gui.Parent = PlayerGui
    Aim.Gui = gui

    local fovFrame = Instance.new("Frame")
    fovFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    fovFrame.Position = UDim2.fromScale(0.5, 0.5)
    fovFrame.BackgroundTransparency = 1
    fovFrame.BorderSizePixel = 0
    fovFrame.Visible = false
    fovFrame.Parent = gui
    Instance.new("UICorner", fovFrame).CornerRadius = UDim.new(1, 0)
    local fovStroke = Instance.new("UIStroke", fovFrame)
    fovStroke.Thickness = 1.5; fovStroke.Transparency = 0.4
    Aim.FovFrame = fovFrame

    local tBox = Instance.new("Frame")
    tBox.AnchorPoint = Vector2.new(0.5, 0.5)
    tBox.BackgroundTransparency = 1
    tBox.BorderSizePixel = 0
    tBox.Visible = false
    tBox.Parent = gui
    Instance.new("UICorner", tBox).CornerRadius = UDim.new(0, 4)
    local tStroke = Instance.new("UIStroke", tBox)
    tStroke.Thickness = 2; tStroke.Transparency = 0.1
    Aim.TargetBox = tBox

    local line = Instance.new("Frame")
    line.AnchorPoint = Vector2.new(0, 0.5)
    line.BackgroundColor3 = Config.AIM_TargetColor
    line.BackgroundTransparency = 0.4
    line.BorderSizePixel = 0
    line.Size = UDim2.new(0, 0, 0, 2)
    line.Visible = false
    line.Parent = gui
    Aim.Line = line

    local function getKiller()
        for _, plr in Players:GetPlayers() do
            if plr == LP then continue end
            if not plr.Team or plr.Team.Name ~= "Killer" then continue end
            if not plr.Character then continue end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            return plr, plr.Character
        end
    end

    local function getPart(char)
        return char:FindFirstChild(Config.AIM_TargetPart)
            or char:FindFirstChild("Head")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("HumanoidRootPart")
    end

    local function wallBlocked(targetPos, targetChar)
        if not Config.AIM_WallCheck then return false end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {LP.Character or LP, Camera, targetChar}
        return workspace:Raycast(Camera.CFrame.Position, targetPos - Camera.CFrame.Position, params) ~= nil
    end

    local function screenDist(targetPos)
        local sp, onScreen = Camera:WorldToViewportPoint(targetPos)
        if not onScreen or sp.Z < 0 then return math.huge end
        local c = Camera.ViewportSize / 2
        return (Vector2.new(sp.X, sp.Y) - c).Magnitude, sp
    end

    local function aimAt(targetPos)
        local camPos = Camera.CFrame.Position
        local targetCF = CFrame.lookAt(camPos, targetPos)
        local s = Config.AIM_Smoothing
        if s <= 0.001 or s >= 0.999 then
            Camera.CFrame = targetCF
        else
            Camera.CFrame = Camera.CFrame:Lerp(targetCF, s)
        end
    end

    local function hasGun()
        if not LP.Character then return false end
        local tool = LP.Character:FindFirstChildOfClass("Tool")
        if not tool then return false end
        local lower = tool.Name:lower()
        for kw in Config.AIM_GunKeywords:gmatch("[^,]+") do
            if lower:find(kw:gsub("%s+", ""):lower(), 1, true) then return true end
        end
        return false
    end
    Aim.HasGun = hasGun

    function Aim.SetHeld(state) aimHeld = state end
    function Aim.IsHeld() return aimHeld end

    function Aim.Step()
        if Config.AIM_Enabled and Config.AIM_ShowFOV then
            fovFrame.Visible = true
            fovFrame.Size = UDim2.fromOffset(Config.AIM_FOV * 2, Config.AIM_FOV * 2)
            fovStroke.Color = Config.AIM_FOVColor
        else
            fovFrame.Visible = false
        end

        tBox.Visible = false
        line.Visible = false
        currentTarget = nil

        if not Config.AIM_Enabled then return end
        if Config.AIM_RequireAim and not aimHeld then return end

        local plr, char = getKiller()
        if not plr then return end
        local part = getPart(char)
        if not part then return end

        local dist, sp = screenDist(part.Position)
        if dist > Config.AIM_FOV then return end
        if wallBlocked(part.Position, char) then return end

        aimAt(part.Position)
        currentTarget = plr

        if Config.AIM_ShowTarget and sp then
            tBox.Visible = true
            tBox.Position = UDim2.fromOffset(sp.X, sp.Y)
            tBox.Size = UDim2.fromOffset(50, 50)
            tStroke.Color = Config.AIM_TargetColor

            local c = Camera.ViewportSize / 2
            local dx = sp.X - c.X
            local dy = sp.Y - c.Y
            local len = math.sqrt(dx * dx + dy * dy)
            if len > 5 then
                line.Visible = true
                line.Position = UDim2.fromOffset(c.X, c.Y)
                line.Size = UDim2.new(0, len, 0, 2)
                line.Rotation = math.deg(math.atan2(dy, dx))
            end
        end

        if Config.AIM_AutoFire and hasGun() then
            if os.clock() - lastFire >= Config.AIM_FireCooldown then
                local tool = LP.Character:FindFirstChildOfClass("Tool")
                if tool then
                    pcall(function() tool:Activate() end)
                    lastFire = os.clock()
                end
            end
        end
    end

    function Aim.GetTarget() return currentTarget end

    function Aim.Fire()
        if not LP.Character then return end
        local tool = LP.Character:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
    end

    function Aim.Destroy() if gui then gui:Destroy() end end
end

