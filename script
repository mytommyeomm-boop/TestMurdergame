-- ═══════════════ ESP TOGGLE KEY ═══════════════
local espKbConn = UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Config.ESP_ToggleKey then
        Config.ESP_Enabled = not Config.ESP_Enabled
        if not Config.ESP_Enabled then ESP:ClearAll() end
        if espToggleUI then pcall(function() espToggleUI:Set(Config.ESP_Enabled) end) end
    end
end)

-- ═══════════════ CLEANUP ═══════════════
_G._MurderSuite = {
    cleanup = function()
        if espConn then espConn:Disconnect() end
        if espKbConn then espKbConn:Disconnect() end
        if aimKeyConnBegan then aimKeyConnBegan:Disconnect() end
        if aimKeyConnEnded then aimKeyConnEnded:Disconnect() end
        pcall(function() RunService:UnbindFromRenderStep("MurderAimLock") end)
        pcall(function() ESP:Destroy() end)
        pcall(function() AR.Destroy() end)
        pcall(function() Aim.Destroy() end)
        pcall(function() Rayfield:Destroy() end)
        _G._MurderSuite = nil
    end,
}

