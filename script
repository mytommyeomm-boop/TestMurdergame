_G._MurderSuite = {
    Config = Config,
    Caps = Caps,
    ESP = ESP,
    AR = AR,
    Aim = Aim,
    HUD = HUD,
    syncUI = function(flag, state)
        Config[flag] = state
        local list = SyncUI[flag]
        if not list then return end
        for _, obj in ipairs(list) do
            pcall(function() obj:Set(state) end)
        end
    end,
    cleanup = function()
        for _, c in ipairs(inputConns) do pcall(function() c:Disconnect() end) end
        if espConn then espConn:Disconnect() end
        pcall(function() RunService:UnbindFromRenderStep("MurderAimLock") end)
        pcall(function() ESP:Destroy() end)
        pcall(function() AR.Destroy() end)
        pcall(function() Aim.Destroy() end)
        pcall(function() if HUD.Destroy then HUD:Destroy() end end)
        pcall(function() Rayfield:Destroy() end)
        _G._MurderSuite = nil
    end,
}

