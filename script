local aimKeyConnBegan = UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if (Config.AIM_UseRightClick and input.UserInputType == Enum.UserInputType.MouseButton2)
    or (input.KeyCode == Config.AIM_Keybind) then
        Aim.SetHeld(true)
    end
end)
local aimKeyConnEnded = UIS.InputEnded:Connect(function(input, gp)
    if (Config.AIM_UseRightClick and input.UserInputType == Enum.UserInputType.MouseButton2)
    or (input.KeyCode == Config.AIM_Keybind) then
        Aim.SetHeld(false)
    end
end)

