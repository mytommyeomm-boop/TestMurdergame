-- HUD ทำงานได้ทุก device — toggle ได้, ลากได้ (mouse + touch)
local HUD = {}
do
    local gui = Instance.new("ScreenGui")
    gui.Name = "MurderHUD"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 1000
    gui.Enabled = Config.HUD_Enabled
    gui.Parent = PlayerGui
    HUD.Gui = gui

    local topInset  = GuiService:GetGuiInset().Y
    local FONT = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)
    local SP = 12

    local function styleBtn(btn, color, strokeColor)
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = false
        btn.BackgroundColor3 = color
        btn.BackgroundTransparency = Config.HUD_Opacity
        btn.FontFace = FONT
        btn.TextColor3 = Color3.new(1, 1, 1)
        Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
        local s = Instance.new("UIStroke", btn)
        s.Color = strokeColor; s.Thickness = 2
        return s
    end

    local function makeDraggable(btn)
        local dragging, dragStart, startPos
        btn.InputBegan:Connect(function(input)
            if Config.HUD_LockPositions then return end
            if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                dragStart = input.Position
                startPos = btn.Position
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseMovement) then
                local d = input.Position - dragStart
                btn.Position = UDim2.fromOffset(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
    end

    -- HUD button factory (งานทั้ง PC + mobile)
    local function makeButton(name, text, size, anchor, pos, color, strokeColor, onClick, onHold)
        local btn = Instance.new("TextButton")
        btn.Name = name
        btn.Size = UDim2.fromOffset(size, size)
        btn.AnchorPoint = anchor
        btn.Position = pos
        btn.Text = text
        btn.TextSize = math.floor(size * 0.45)
        local stroke = styleBtn(btn, color, strokeColor)
        btn.Parent = gui

        if onHold then
            local touchId = nil
            btn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    touchId = input
                    onHold(true)
                    btn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
                    stroke.Color = Color3.fromRGB(200, 255, 200)
                end
            end)
            btn.InputEnded:Connect(function(input)
                if (input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseButton1)
                and input == touchId then
                    touchId = nil
                    onHold(false)
                    btn.BackgroundColor3 = color
                    stroke.Color = strokeColor
                end
            end)
        elseif onClick then
            btn.MouseButton1Click:Connect(onClick)
        end
        return btn, stroke
    end

    -- MENU
    local menuBtn
    if Config.HUD_ShowMenu then
        menuBtn = makeButton(
            "MenuBtn", "☰", Config.HUD_BtnSize,
            Vector2.new(0, 0), UDim2.fromOffset(SP, topInset + 8),
            Color3.fromRGB(120, 60, 200), Color3.fromRGB(200, 140, 255),
            function() pcall(function() Rayfield:Toggle() end) end
        )
        makeDraggable(menuBtn)
    end

    -- ESP TOGGLE
    local espBtn, espStroke
    if Config.HUD_ShowESP then
        espBtn, espStroke = makeButton(
            "ESPBtn", "👁", Config.HUD_BtnSize,
            Vector2.new(1, 0), UDim2.new(1, -SP, 0, topInset + 8),
            Color3.fromRGB(60, 140, 220), Color3.fromRGB(150, 200, 255),
            function()
                Config.ESP_Enabled = not Config.ESP_Enabled
                if not Config.ESP_Enabled then ESP:ClearAll() end
                if _G._MurderSuite and _G._MurderSuite.syncUI then
                    _G._MurderSuite.syncUI("ESP_Enabled", Config.ESP_Enabled)
                end
            end
        )
        makeDraggable(espBtn)
    end

    -- AIM (hold)
    local aimBtn, aimStroke
    if Config.HUD_ShowAim then
        aimBtn, aimStroke = makeButton(
            "AimBtn", "🎯", Config.HUD_AimSize,
            Vector2.new(1, 1), UDim2.new(1, -SP, 1, -12),
            Color3.fromRGB(200, 40, 40), Color3.fromRGB(255, 150, 150),
            nil,
            function(state) Aim.SetHeld(state) end
        )
        aimStroke.Thickness = 3
    end

    -- FIRE (tap)
    local fireBtn
    if Config.HUD_ShowFire then
        fireBtn = makeButton(
            "FireBtn", "🔥", 70,
            Vector2.new(1, 1),
            UDim2.new(1, -SP, 1, -(12 + Config.HUD_AimSize + 20)),
            Color3.fromRGB(255, 140, 20), Color3.fromRGB(255, 200, 100),
            function() Aim.Fire() end
        )
        fireBtn.Visible = false
    end

    -- STATUS
    local statusLbl
    if Config.HUD_ShowStatus then
        statusLbl = Instance.new("TextLabel")
        statusLbl.Name = "StatusLbl"
        statusLbl.Size = UDim2.fromOffset(150, 28)
        statusLbl.AnchorPoint = Vector2.new(0.5, 0)
        statusLbl.Position = UDim2.new(0.5, 0, 0, topInset + 8)
        statusLbl.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        statusLbl.BackgroundTransparency = 0.3
        statusLbl.BorderSizePixel = 0
        statusLbl.FontFace = FONT
        statusLbl.TextSize = 13
        statusLbl.TextColor3 = Color3.fromRGB(100, 255, 100)
        statusLbl.Text = "✓ Ready"
        statusLbl.Parent = gui
        Instance.new("UICorner", statusLbl).CornerRadius = UDim.new(1, 0)
    end

    -- Update loop
    task.spawn(function()
        while gui.Parent do
            task.wait(0.25)
            -- ESP button state
            if espBtn then
                local on = Config.ESP_Enabled
                espBtn.BackgroundColor3 = on and Color3.fromRGB(60, 140, 220) or Color3.fromRGB(80, 80, 80)
                espStroke.Color = on and Color3.fromRGB(150, 200, 255) or Color3.fromRGB(120, 120, 120)
            end
            -- Fire button visibility
            if fireBtn then
                fireBtn.Visible = Config.AIM_Enabled
                    and not Config.AIM_AutoFire
                    and Aim.HasGun and Aim.HasGun()
            end
            -- Status
            if statusLbl then
                local parts = {}
                if Config.AR_Enabled then table.insert(parts, "AR✓") end
                if Config.AIM_Enabled then table.insert(parts, "Aim✓") end
                if Config.ESP_Enabled then table.insert(parts, "ESP✓") end
                statusLbl.Text = #parts > 0 and table.concat(parts, "  ") or "✗ Idle"
                statusLbl.TextColor3 = #parts > 0
                    and Color3.fromRGB(100, 255, 100)
                    or Color3.fromRGB(255, 100, 100)
            end
        end
    end)

    function HUD:SetEnabled(state)
        Config.HUD_Enabled = state
        gui.Enabled = state
    end

    function HUD:SetOpacity(v)
        Config.HUD_Opacity = v
        for _, btn in ipairs(gui:GetDescendants()) do
            if btn:IsA("TextButton") then
                btn.BackgroundTransparency = v
            end
        end
    end

    function HUD:Destroy() if gui then gui:Destroy() end end

    HUD.MenuBtn = menuBtn
    HUD.ESPBtn = espBtn
    HUD.AimBtn = aimBtn
    HUD.FireBtn = fireBtn
    HUD.StatusLbl = statusLbl
end

